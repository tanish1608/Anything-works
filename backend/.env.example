# Copy to .env and adjust. Never commit real secrets.
APP_ENV=dev
DATABASE_URL=sqlite:///./data/app.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# GEMINI_API_KEY=
# VISION_MODEL=gemini-3.8-flash
# VISION_EFFORT=medium
# Review-only agent workflow. New updates skip the legacy vision auto-approval path.
AGENT_ENABLED=false
AGENT_TIMEOUT_SECONDS=60
AGENT_TEXT_MODEL=gemini-3.5-flash-lite
AGENT_TEXT_TIMEOUT_SECONDS=15
AGENT_VOICE_MODEL=gemini-3.5-transcribe
AGENT_VOICE_TIMEOUT_SECONDS=120
